# Devin API -- https://docs.devin.ai/api-reference/overview
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai/v3

# The Superset fork under remediation
FORK_REPO=your-org/superset-fork
BASELINE_SHA=9f5611aca5425416d6eecd9ebe68fa3c865c4abe

# Budget. The per-session cap is enforced by the Devin API itself; the global
# ceiling is checked before any session is created and persisted in SQLite so it
# survives a restart.
MAX_ACU_PER_SESSION=10
GLOBAL_ACU_CEILING=250
MAX_CONCURRENT_SESSIONS=4

# Shared secret for GitHub webhook signature verification. Generate with:
#   openssl rand -hex 24
# The endpoint is public by necessity and it spends money -- do not leave unset.
GITHUB_WEBHOOK_SECRET=

WEBHOOK_PORT=8099
DASHBOARD_PORT=8100
